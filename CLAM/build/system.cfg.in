####
#### TODO! ON LINUX THIS FILE SHOULD BE GENERATED BY configure FROM
#### A system.cfg.in
#### 
#### ALSO: src/Defines/[Unix|Windows]/config.h[.in] SHOULD DISAPPEAR!
#### instead, we have a global src/Defines/config.h , where defines may be
#### made based one the DEFINES specified in this file
####

USE_XERCESC = $(USE_XML)

RECURSE_INCLUDE_PATHS = $(PRJ_RECURSE_INCLUDE_PATHS) $(TOP)/src $(TOP)/externals \
	$(USE_XERCESC?$(TOP)/../xercesc)

INCLUDE_PATHS = $(PRJ_INCLUDE_PATHS) \
	$(USE_FLTK?)

PRE_INCLUDES = $(TOP)/src/Defines/config.h

LIBRARY_PATHS = \
	$(USE_FLTK?) \
	$(USE_XERCESC?$(TOP)/../xercesc/lib)

LIBRARIES = \
	$(USE_DOUBLE?rfftw:srfftw) \
	$(USE_FLTK?fltk) \
	$(USE_FLTK?GL) \
	$(USE_ALSA?asound) \
	$(USE_XERCESC?xerces-c) \


#	$(USE_DOUBLE?fftw) \
#	$(USE_FLOAT?sfftw) \

SOURCES_AUDIODEVICE = \
	$(USE_ALSA?$(TOP)/src/Tools/AudioIO/Linux/ALSAAudioDevice.cxx)

DEFINES = \
	HAVE_STANDARD_SSTREAM \
	HAVE_STANDARD_SSTREAM_STR \
	$(USE_DOUBLE?CLAM_DOUBLE:CLAM_FLOAT) \
	$(USE_DEBUG?DEBUG) \
	$(USE_DEBUG?_DEBUG) \
	$(USE_XML?CLAM_USE_XML) \
	CLAM_HAVE_PTHREADS
