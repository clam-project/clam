
USE_XERCESC = $(USE_XML)

RECURSE_INCLUDE_PATHS = \
	$(PRJ_RECURSE_INCLUDE_PATHS) \
	$(TOP)/src $(TOP)/externals \
	$(USE_XERCESC?@XERCESC_INCLUDES@)

INCLUDE_PATHS = \
	$(PRJ_INCLUDE_PATHS) \
	$(USE_FFTW?@FFTW_INCLUDES@) \
	$(USE_FLTK?@FLTK_INCLUDES@)

PRE_INCLUDES = $(TOP)/src/Defines/preinclude.hxx

LIBRARY_PATHS = \
	$(USE_FFTW?@FFTW_LIB_PATH@) \
	$(USE_FLTK?@FLTK_LIB_PATH@) \
	$(USE_XERCESC?@XERCESC_LIB_PATH@)

LIBRARIES = \
	$(USE_FFTW?$(USE_DOUBLE?rfftw:srfftw)) \
	$(USE_ALSA?asound) \
	$(USE_FLTK?@FLTK_LIBS@) \
	$(USE_XERCESC?@XERCESC_LIBS@)

SOURCES_AUDIODEVICE = \
	$(USE_ALSA?$(TOP)/src/Tools/AudioIO/Linux/ALSAAudioDevice.cxx)

SOURCES_MIDIDEVICE = \
	$(USE_ALSA?$(TOP)/src/Tools/MIDIIO/Linux/ALSAMIDIDevice.cxx) \
	$(USE_ALSA?$(TOP)/src/Tools/MIDIIO/File/FileMIDIDevice.cxx)

DEFINES = \
	@DEFINE_HAVE_STANDARD_SSTREAM@ \
	@DEFINE_HAVE_STANDARD_SSTREAM_STR@ \
	@DEFINE_CLAM_HAVE_PTHREADS@ \
	$(USE_DOUBLE?CLAM_DOUBLE:CLAM_FLOAT) \
	$(USE_DEBUG?DEBUG) \
	$(USE_DEBUG_CHECKS?_DEBUG) \
	$(USE_XML?CLAM_USE_XML)

CXXFLAGS = \
	$(USE_DEBUG?"-g -fno-inline") \
	$(USE_OPTIMIZE?"-O6 -fomit-frame-pointer")
