
USE_XERCESC = $(USE_XML)

SEARCH_RECURSE_INCLUDES = \
	$(PRJ_SEARCH_RECURSE_INCLUDES) \
	$(TOP)/src $(TOP)/externals \
	$(USE_XERCESC?/root/stanford/xercesc/include)

SEARCH_INCLUDES = \
	$(PRJ_SEARCH_INCLUDES) \
	$(USE_FFTW?) \
	$(USE_FLTK?)

PRE_INCLUDES = $(TOP)/src/Defines/preinclude.hxx

LIBRARY_PATHS = \
	$(USE_FFTW?) \
	$(USE_FLTK?) \
	$(USE_XERCESC?-L/root/stanford/xercesc/lib)

LIBRARIES = \
	$(USE_FFTW?$(USE_DOUBLE?rfftw:srfftw)) \
	$(USE_ALSA?asound) \
	$(USE_FLTK?-lfltk) \
	$(USE_XERCESC?-lxerces-c)

SOURCES_AUDIODEVICE = \
	$(USE_ALSA?$(TOP)/src/Tools/AudioIO/Linux/ALSAAudioDevice.cxx)

SOURCES_MIDIDEVICE = \
	$(USE_ALSA?$(TOP)/src/Tools/MIDIIO/Linux/ALSAMIDIDevice.cxx) \
	$(USE_ALSA?$(TOP)/src/Tools/MIDIIO/File/FileMIDIDevice.cxx)

DEFINES = \
	HAVE_STANDARD_SSTREAM \
	HAVE_STANDARD_SSTREAM_STR \
	CLAM_HAVE_PTHREADS \
	$(USE_DOUBLE?CLAM_DOUBLE:CLAM_FLOAT) \
	$(USE_DEBUG?DEBUG) \
	$(USE_DEBUG_CHECKS?_DEBUG) \
	$(USE_XML?CLAM_USE_XML)

CXXFLAGS_DEBUG = -g -fno_inline
CXXFLAGS_OPTIMIZE = -O6 -fomit-frame-pointer

CXXFLAGS = \
	$(USE_DEBUG?$(CXXFLAGS_DEBUG)) \
	$(USE_OPTIMIZE?$(CXXFLAGS_OPTIMIZE))
