@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(WIN32)
	# On Windows (vcpkg) clam_audioio passes libsndfile's include directory
	# on to its users, through this pkg-config target.
	find_dependency(PkgConfig)
	pkg_check_modules(SNDFILE REQUIRED IMPORTED_TARGET sndfile)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CLAMTargets.cmake")

# The network refactoring script NetworkEditor embeds, with Python support
set(CLAM_REFACTOR_SCRIPT "@PACKAGE_CMAKE_INSTALL_DATADIR@/clam/clamrefactor.py")

# Installed when NetworkEditor's monitor widget library was built.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/CLAMQtMonitorsTargets.cmake")
	find_dependency(OpenGL)
	find_dependency(Qt6 COMPONENTS Core Gui Widgets Svg OpenGL OpenGLWidgets UiPlugin)
	include("${CMAKE_CURRENT_LIST_DIR}/CLAMQtMonitorsTargets.cmake")
endif()

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/CLAMQmlWidgetsTargets.cmake")
	find_dependency(Qt6 COMPONENTS Qml Quick)
	include("${CMAKE_CURRENT_LIST_DIR}/CLAMQmlWidgetsTargets.cmake")
endif()

check_required_components(CLAM)
