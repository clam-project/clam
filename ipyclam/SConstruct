import os
import sys
import glob
import tomllib
import enscons

metadata = tomllib.loads(open("pyproject.toml", "rb").read().decode())["project"]
tag = enscons.get_binary_tag()

def _find_clam_prefix():
    for p in [os.environ.get('CLAM_PREFIX', ''), '/usr/local', '/usr']:
        if p and os.path.exists(os.path.join(p, 'share', 'clam', 'sconstools', 'clam.py')):
            return p
    return os.environ.get('CLAM_PREFIX', '') or '/usr/local'

building_sdist = 'sdist' in sys.argv

options_filename = 'options.cache'
options = Variables(options_filename, ARGUMENTS)
options.Add(PathVariable('clam_prefix', 'The prefix where CLAM was installed',
    _find_clam_prefix()))
options.Add(BoolVariable('enable_clam', 'Compile CLAM engine', 'yes'))
options.Add(BoolVariable('enable_jack', 'Compile JACK engine', 'yes'))
if sys.platform=="linux" :
	options.Add(BoolVariable('crossmingw', 'Using MinGW crosscompiler mode', 'no') )

toolchain = 'default'
if sys.platform == 'win32': toolchain = 'mingw'
env = Environment(ENV=os.environ, tools=[toolchain], options=options)
options.Save(options_filename, env)
Help(options.GenerateHelpText(env))

env.SConsignFile() # Single signature file

crosscompiling = env.get("crossmingw")
isWindowsPlatform = sys.platform=='win32' or crosscompiling
isLinuxPlatform = sys.platform=='linux' and not crosscompiling
isDarwinPlatform = sys.platform=='darwin'

if env['enable_clam'] and not building_sdist :
    CLAMInstallDir = env['clam_prefix']
    clam_sconstoolspath = os.path.join(CLAMInstallDir,'share','clam','sconstools')
    if not os.access(os.path.join(clam_sconstoolspath,"clam.py"), os.R_OK):
        raise Exception(
            "CLAM not installed at '%s'. Use clam_prefix=... or set CLAM_PREFIX."
            % CLAMInstallDir)
    env.Tool('clam', toolpath=[clam_sconstoolspath])

    env.EnableClamModules([
        'clam_core',
        'clam_processing',
        'clam_audioio',
        'clam_qtmonitors',
    ], CLAMInstallDir)

env.ParseConfig('python3-config --cflags --embed')
env.ParseConfig('python3-config --libs --embed')
env.ParseConfig('pkg-config --cflags --libs pyside6')

env.ParseConfig('pkg-config Qt6UiTools Qt6Gui Qt6Widgets Qt6Core --cflags --libs') # UI binding

if env['enable_jack'] :
	env.ParseConfig('pkg-config --cflags --libs jack')

pyversion = f"{sys.version_info.major}{sys.version_info.minor}"
env.AppendUnique(LIBS=[f'boost_python{pyversion}'])

# python3-config adds a flag that is refused by g++
if '-Wstrict-prototypes' in env['CCFLAGS'] :
	env['CCFLAGS'].remove('-Wstrict-prototypes')

if True :
	env["SHCXXCOMSTR"] = "Compiling $SOURCE -> $TARGET"
	env["CXXCOMSTR"] = "Compiling $SOURCE -> $TARGET"
	env["SHLINKCOMSTR"] = "Linking $SOURCES -> $TARGET"
	env["LINKCOMSTR"] = "Linking $SOURCES -> $TARGET"

def print_cmd_line(commandline, target, source, env) :
	sys.stdout.write("\033[32;1m%s\033[0m\n"%commandline)
	sys.stdout.flush()
env['PRINT_CMD_LINE_FUNC'] = print_cmd_line


env["SHOBJPREFIX"] = "generated/"


shibokenunwrap = env.SharedObject(source='src/shibokenunwrap.cxx')
sipunwrap = env.SharedObject(source='src/sipunwrap.cxx')

clamengine_module = env.SharedLibrary (
	target='ipyclam/clam/engine',
	source=[
		'src/Clam_Engine.cxx',
		shibokenunwrap,
		sipunwrap,
		],
	SHLIBPREFIX='',
) if env['enable_clam']  else []

clamengine_config_module = env.SharedLibrary (
	target='ipyclam/clam/configurationproxy',
	source=[
		'src/Clam_ConfigurationProxy.cxx',
		'src/ConfigurationProxy.cxx',
		],
	SHLIBPREFIX='',
) if env['enable_clam']  else []

jackengine_module = env.SharedLibrary (
	target='ipyclam/jack/engine',
	source=[
		'src/Jack_Engine.cxx',
		],
	SHLIBPREFIX='',
) if env['enable_jack']  else []

dummyProcessingsModule = env.SharedLibrary (
	target='ipyclam/dummy/processing',
	source=[
		'src/DummyProcessings.cxx',
		],
	SHLIBPREFIX='',
) if env['enable_clam']  else []

ui_pyside_module = env.SharedLibrary (
	target='ipyclam/clam/PySide',
	source=[
		'src/PySideModule.cxx',
		shibokenunwrap,
		],
	SHLIBPREFIX='',
)

ui_pyqt_module = env.SharedLibrary (
	target='ipyclam/clam/PyQt',
	source=[
		'src/PyQtModule.cxx',
		sipunwrap,
		],
	SHLIBPREFIX='',
)

program = env.Program(
	target='ipyclam_console',
	source='src/ipyclam_console.cxx',
)

env.Append(tools=["packaging"])
env["PACKAGE_METADATA"] = metadata
env["WHEEL_TAG"] = tag
enscons.generate(env)

py_modules = [
	f for f in (
		glob.glob('ipyclam/*.py')
		+ glob.glob('ipyclam/clam/*.py')
		+ glob.glob('ipyclam/jack/*.py')
		+ glob.glob('ipyclam/dummy/*.py')
	)
	if "Test" not in f and "test" not in f
]

all_so_modules = (
	clamengine_module + clamengine_config_module
	+ dummyProcessingsModule + ui_pyside_module + ui_pyqt_module
	+ jackengine_module
)

platlib = env.Whl("platlib", py_modules + all_so_modules, root=".")
whl = env.WhlFile(source=platlib)

sdist = env.SDist(source=[
	"pyproject.toml",
	"SConstruct",
	"MANIFEST.in",
	"README",
] + glob.glob("src/*.cxx") + glob.glob("src/*.hxx") + py_modules)

env.Default(whl)

import subprocess
def pip_install(target, source, env):
    subprocess.run([sys.executable, '-m', 'pip', 'install', '-e', '.'], check=True)

env.Command('install', all_so_modules + [program], action=pip_install)
